{
  "name": "deljdlx/taxonomy",
  "description": "Generic taxonomies and terms for Laravel (hierarchical, slugs, polymorphic attach)",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Deljdlx\\Taxonomy\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Deljdlx\\Taxonomy\\TaxonomyServiceProvider"
      ]
    }
  },
  "require": {
    "php": ">=8.3",
    "illuminate/support": "^12.0",
    "illuminate/database": "^12.0",
    "illuminate/routing": "^12.0",
    "illuminate/http": "^12.0",
    "spatie/laravel-query-builder": "^6.3"
  }
}
